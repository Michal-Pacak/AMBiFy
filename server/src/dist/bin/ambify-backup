#!/usr/bin/python3 -I
"""Copies the AMBiFy SQLite database to the NAS and keeps the newest copies.

Usage: ambify-backup DATABASE TARGET_DIR NAS_MOUNT_POINT
Refuses to run when the NAS is not mounted, so copies never land on the system disk.
"""
import datetime
import pathlib
import shutil
import sqlite3
import sys

KEEP = 30


def is_mounted(path: str) -> bool:
    with open("/proc/self/mounts") as mounts:
        return any(line.split()[1] == path for line in mounts)


def main() -> int:
    database, target, nas = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
    if not is_mounted(nas):
        print(f"NAS not mounted at {nas}, backup skipped", file=sys.stderr)
        return 1

    name = f"ambify-{datetime.date.today().isoformat()}.db"
    partial = target / (name + ".part")
    # SQLite's online backup gives a consistent copy while the server keeps running.
    source = sqlite3.connect(database)
    copy = sqlite3.connect(partial)
    with copy:
        source.backup(copy)
    copy.close()
    source.close()
    partial.replace(target / name)

    for old in sorted(target.glob("ambify-*.db"))[:-KEEP]:
        old.unlink()
    print(f"Backup written: {target / name}")
    copied, removed = mirror_files(database.parent / "lists-files", target / "lists-files")
    print(f"List photos and files: {copied} copied, {removed} moved to the deleted ones (kept {KEEP} days)")
    copied, removed = mirror_files(database.parent / "avatars", target / "avatars")
    print(f"Profile photos: {copied} copied, {removed} moved to the deleted ones (kept {KEEP} days)")
    return 0


def mirror_files(source: pathlib.Path, target: pathlib.Path) -> tuple[int, int]:
    """Photos and files of lists (0.7.3) and profile photos (0.7.6): new ones are copied; one deleted in AMBiFy is moved to
    lists-files-deleted/<date of deletion>/ and kept KEEP days, like the database copies, so a restored
    database finds its photos."""
    if not source.is_dir():
        return 0, 0
    copied = removed = 0
    present = set()
    for file in source.glob("*/*"):
        if not file.is_file() or file.parent.name.startswith(".") or file.name.endswith(".part"):
            continue
        relative = file.relative_to(source)
        present.add(relative)
        copy = target / relative
        if not copy.exists() or copy.stat().st_size != file.stat().st_size:
            copy.parent.mkdir(parents=True, exist_ok=True)
            partial = copy.with_name(copy.name + ".part")
            shutil.copyfile(file, partial)
            partial.replace(copy)
            copied += 1
    deleted = target.parent / (target.name + "-deleted")
    today = datetime.date.today()
    if target.is_dir():
        for copy in target.glob("*/*"):
            relative = copy.relative_to(target)
            if copy.is_file() and relative not in present:
                kept = deleted / today.isoformat() / relative
                kept.parent.mkdir(parents=True, exist_ok=True)
                copy.replace(kept)
                removed += 1
    if deleted.is_dir():
        for day in deleted.iterdir():
            try:
                old = (today - datetime.date.fromisoformat(day.name)).days > KEEP
            except ValueError:
                continue
            if day.is_dir() and old:
                shutil.rmtree(day)
    return copied, removed


if __name__ == "__main__":
    sys.exit(main())
