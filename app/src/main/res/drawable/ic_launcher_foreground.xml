        android:scaleX="0.108"
        android:scaleY="0.108"
        android:translateX="21.6"
        android:translateY="21.78">

        <!-- Left pillar -->
        <path
            android:pathData="M300,116.6 L357,224.2 L198,480 L110,480 Z"
            android:strokeWidth="1.8"
            android:strokeLineJoin="round">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="159.4"
                    android:startY="116.6"
                    android:endX="307.6"
                    android:endY="480">
                    <item android:offset="0" android:color="#FFE5AE32" />
                    <item android:offset="0.14" android:color="#FFCA921E" />
                    <item android:offset="0.28" android:color="#FFE2A629" />
                    <item android:offset="0.42" android:color="#FFA8730D" />
