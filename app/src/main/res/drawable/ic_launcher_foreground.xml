                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="110"
                    android:startY="116.6"
                    android:endX="357"
                    android:endY="443.7">
                    <item android:offset="0" android:color="#D9FFD66B" />
                    <item android:offset="0.35" android:color="#A6D4991E" />
                    <item android:offset="0.70" android:color="#597A4B06" />
                    <item android:offset="1" android:color="#CCE8B038" />
