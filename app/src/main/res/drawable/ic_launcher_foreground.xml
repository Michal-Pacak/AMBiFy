<?xml version="1.0" encoding="utf-8"?>
<!--
    AMBiFy launcher icon foreground: logo_static.svg at 92% height (in-app logo uses 83%), gold pillars.
    Paths use the 600x600 logo coordinates; the group maps them into the
    72dp visible area of the 108dp adaptive icon (logo at 90% of it).
-->
